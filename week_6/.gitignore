# Resumable pipeline's own output tree (scratch; the graded artifacts are submission_artifacts/)
pipeline_artifacts/

# Heavy binary checkpoints (32MB each) — regenerated by run_demo.py; the crash/resume/fork
# evidence lives in run.log + evidence.json (batch ids & hashes), not in these blobs.
# Everything else under submission_artifacts/ (log, evidence, manifests, ledgers, perf, shards) is committed.
submission_artifacts/checkpoints/*.npz

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Atomic-write temp files (should never linger, but just in case)
*.tmp

# Editor / OS cruft
.DS_Store
.ipynb_checkpoints/

# Local Claude Code settings (machine-specific, not part of the submission)
.claude/settings.local.json
